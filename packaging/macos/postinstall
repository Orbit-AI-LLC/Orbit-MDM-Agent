#!/bin/sh
# Orbit agent .pkg: the binary is in place; enroll it, or, when this computer
# is already enrolled, start the new version (`orbit-agent install --package`:
# the server and token come from the ai.orbit.agent managed preferences a
# configuration profile sets). What it says goes to the install log.
log=/var/log/orbit-agent-install.log
"/Library/Orbit/Orbit Agent Service.app/Contents/MacOS/orbit-agent" install --package >>"$log" 2>&1
status=$?
[ "$status" -eq 0 ] || echo "orbit-agent install --package failed ($status); see $log" >&2

# Start the per-user LaunchAgents now for whoever is signed in; otherwise the
# plists in /Library/LaunchAgents load them at the next login. These are the
# menu-bar app and the remote-desktop helper (which holds Screen Recording, so it
# must run in the GUI session — that's what lets it be granted without an MDM).
user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)
if [ -n "$user" ] && [ "$user" != "root" ]; then
  uid=$(/usr/bin/id -u "$user" 2>/dev/null)
  if [ -n "$uid" ]; then
    # Load these through `launchctl asuser`, inside the user's own session: a
    # direct `bootstrap gui/$uid` from the installer context fails with EIO
    # ("Bootstrap failed: 5: Input/output error"). kickstart makes sure it runs.
    for agent in ai.orbit.agent.menu ai.orbit.agent.desktop; do
      /bin/launchctl asuser "$uid" /bin/launchctl bootout "gui/$uid/$agent" >/dev/null 2>&1
      /bin/launchctl asuser "$uid" /bin/launchctl bootstrap "gui/$uid" "/Library/LaunchAgents/$agent.plist" >>"$log" 2>&1
      /bin/launchctl asuser "$uid" /bin/launchctl kickstart "gui/$uid/$agent" >/dev/null 2>&1
    done
  fi
fi

exit "$status"
